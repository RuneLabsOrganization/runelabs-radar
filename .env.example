# SQLite file location (mounted volume in Docker)
DATABASE_PATH=./data/radar.db

# Long random string; sessions are HMAC-signed with this
SESSION_SECRET=change-me-to-a-long-random-string

# MiniMax (OpenAI-compatible endpoint) — same key as helix-claw
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io/v1
MINIMAX_MODEL=MiniMax-M3
MINIMAX_DAILY_CALL_CAP=500

# Artificial Analysis API (optional — board sync + market scatter use it when set)
AA_API_KEY=

# Exa API (optional — primary search adapter, 20k free requests/month, no card)
EXA_API_KEY=

# Brave Search API (optional — fallback only since Feb 2026 pricing change; the
# exa adapter calls this automatically when Exa errors, no separate source needed)
BRAVE_API_KEY=

# true = anonymous visitors can read the hub (votes/verdicts/admin still need login)
PUBLIC_MODE=false

# canonical public URL — metadata, sitemap, OG cards
SITE_URL=http://localhost:3000

# DANGER (legal): only set true with an Artificial Analysis redistribution
# agreement — it shows AA-derived sections (market scatter, arenas, cost
# explorer) to anonymous visitors. Logged-in members always see them.
AA_PUBLIC=false

# optional: raises GitHub API rate limits for the daily velocity job
GITHUB_TOKEN=

# optional: enables the Product Hunt launch adapter (developer token)
PH_TOKEN=

# where the local embedding model caches its weights — MUST be a persistent path
# (docker-compose pins the worker to /data/hfcache; local dev default is .hfcache)
TRANSFORMERS_CACHE=/data/hfcache

# --- MCP server ---
# true = every /mcp call needs an OAuth bearer token issued by the hub
# (authorize at /oauth/authorize). false/absent = anonymous, IP rate-limited.
MCP_AUTH_REQUIRED=false
# requests/hour per token (authed) or per IP (anonymous)
MCP_RATE_LIMIT=300
# plan generations/day per token or IP (each costs 6-7 LLM calls)
MCP_PLAN_DAILY_CAP=10
# anonymous scout runs/day per IP; signed-in callers use tier quotas
MCP_SCOUT_DAILY_CAP=10
# public URL of the MCP endpoint + the OAuth issuer — set both in production
# MCP_PUBLIC_URL=https://mcp.example.com/mcp
# OAUTH_ISSUER=https://radar.example.com

# --- Stripe (checkout + customer portal; leave empty to keep CTAs on signup fallback) ---
STRIPE_SECRET_KEY=
STRIPE_PRICE_BUILDER=
STRIPE_PRICE_BUILDER_ANNUAL=
STRIPE_PRICE_FACTORY=
STRIPE_PRICE_FACTORY_ANNUAL=
# STRIPE_WEBHOOK_SECRET=   webhook URL: https://<host>/api/auth/stripe/webhook

# --- Resend (password reset + verification; leave empty to skip sending) ---
RESEND_API_KEY=
EMAIL_FROM=Radar <hello@runelabs.org>
